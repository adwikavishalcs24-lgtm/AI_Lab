        "### 8-Puzzle Solver using A* Search Algorithm\n",
        "We will implement the A* algorithm to solve the 8-puzzle problem using two different heuristic functions:\n",
        "1. **Misplaced Tiles**: The number of tiles that are not in their target position.\n",
        "2. **Manhattan Distance**: The sum of the absolute differences of the row and column coordinates between each tile's current and target positions."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "c716dc8e",
        "outputId": "99f2c9c6-614d-41ba-daac-92aa1a1b4e16"
      },
      "source": [
        "import heapq\n",
        "\n",
        "# Goal state representation (1-8 and 0 for the empty tile)\n",
        "GOAL_STATE = (1, 2, 3, 4, 5, 6, 7, 8, 0)\n",
        "\n",
        "class PuzzleState:\n",
        "    def __init__(self, board, parent=None, move=\"\", g=0, h=0):\n",
        "        self.board = board  # 1D tuple representing the 3x3 board\n",
        "        self.parent = parent\n",
        "        self.move = move\n",
        "        self.g = g  # Cost from start to current node\n",
        "        self.h = h  # Heuristic cost to goal\n",
        "        self.f = g + h  # Total cost (f = g + h)\n",
        "\n",
        "    def __lt__(self, other):\n",
        "        return self.f < other.f\n",
        "\n",
        "    def get_blank_index(self):\n",
        "        return self.board.index(0)\n",
        "\n",
        "    def get_neighbors(self):\n",
        "        neighbors = []\n",
        "        idx = self.get_blank_index()\n",
        "        row, col = idx // 3, idx % 3\n",
        "\n",
        "        # Directional moves: (row_offset, col_offset, move_name)\n",
        "        moves = [(-1, 0, \"Up\"), (1, 0, \"Down\"), (0, -1, \"Left\"), (0, 1, \"Right\")]\n",
        "\n",
        "        for dr, dc, move_name in moves:\n",
        "            nr, nc = row + dr, col + dc\n",
        "            if 0 <= nr < 3 and 0 <= nc < 3:\n",
        "                neighbor_idx = nr * 3 + nc\n",
        "                new_board = list(self.board)\n",
        "                # Swap the blank tile with the adjacent tile\n",
        "                new_board[idx], new_board[neighbor_idx] = new_board[neighbor_idx], new_board[idx]\n",
        "                neighbors.append((tuple(new_board), move_name))\n",
        "        return neighbors\n",
        "\n",
        "# --- Heuristic Functions ---\n",
        "\n",
        "def h_misplaced_tiles(board):\n",
        "    \"\"\"Calculates the number of misplaced tiles (excluding the blank tile).\"\"\"\n",
        "    count = 0\n",
        "    for i in range(9):\n",
        "        if board[i] != 0 and board[i] != GOAL_STATE[i]:\n",
        "            count += 1\n",
        "    return count\n",
        "\n",
        "def h_manhattan_distance(board):\n",
        "    \"\"\"Calculates the sum of Manhattan distances of all tiles from their goal positions.\"\"\"\n",
        "    distance = 0\n",
        "    for i in range(9):\n",
        "        val = board[i]\n",
        "        if val != 0:\n",
        "            curr_row, curr_col = i // 3, i % 3\n",
        "            target_idx = GOAL_STATE.index(val)\n",
        "            target_row, target_col = target_idx // 3, target_idx % 3\n",
        "            distance += abs(curr_row - target_row) + abs(curr_col - target_col)\n",
        "    return distance\n",
        "\n",
        "# --- A* Search Algorithm ---\n",
        "\n",
        "def solve_a_star(start_board, heuristic_fn):\n",
        "    \"\"\"Solves the 8-puzzle using A* search. Returns the path of state nodes and nodes expanded.\"\"\"\n",
        "    start_state = PuzzleState(start_board, g=0, h=heuristic_fn(start_board))\n",
        "\n",
        "    open_list = []\n",
        "    heapq.heappush(open_list, start_state)\n",
        "\n",
        "    closed_set = set()\n",
        "    nodes_expanded = 0\n",
        "\n",
        "    while open_list:\n",
        "        current_state = heapq.heappop(open_list)\n",
        "\n",
        "        if current_state.board == GOAL_STATE:\n",
        "            path = []\n",
        "            curr = current_state\n",
        "            while curr:\n",
        "                path.append(curr)\n",
        "                curr = curr.parent\n",
        "            return path[::-1], nodes_expanded\n",
        "\n",
        "        if current_state.board in closed_set:\n",
        "            continue\n",
        "\n",
        "        closed_set.add(current_state.board)\n",
        "        nodes_expanded += 1\n",
        "\n",
        "        for neighbor_board, move in current_state.get_neighbors():\n",
        "            if neighbor_board not in closed_set:\n",
        "                g_cost = current_state.g + 1\n",
        "                h_cost = heuristic_fn(neighbor_board)\n",
        "                neighbor_state = PuzzleState(neighbor_board, parent=current_state, move=move, g=g_cost, h=h_cost)\n",
        "                heapq.heappush(open_list, neighbor_state)\n",
        "\n",
        "    return None, nodes_expanded\n",
        "\n",
        "# --- Helper function to print board steps ---\n",
        "\n",
        "def print_board(board):\n",
        "    for i in range(0, 9, 3):\n",
        "        print(\" \".join(str(x) if x != 0 else \"_\" for x in board[i:i+3]))\n",
        "\n",
        "def display_solution_steps(path):\n",
        "    if not path:\n",
        "        print(\"No solution found.\")\n",
        "        return\n",
        "\n",
        "    print(\"\\n--- Step-by-Step Board Configurations ---\")\n",
        "    for idx, state in enumerate(path):\n",
        "        if idx == 0:\n",
        "            print(\"Start State:\")\n",
        "        else:\n",
        "            print(f\"Step {idx}: Move blank '{state.move}'\")\n",
        "        print_board(state.board)\n",
        "        print(\"-\" * 15)\n",
        "\n",
        "# --- Execution & Demonstration ---\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    # 0 represents the blank space\n",
        "    initial_state = (1, 2, 3, 0, 4, 6, 7, 5, 8)\n",
        "\n",
        "    print(\"Initial State Board:\")\n",
        "    print_board(initial_state)\n",
        "\n",
        "    # Run A* using Misplaced Tiles Heuristic\n",
        "    path_misplaced, nodes_misplaced = solve_a_star(initial_state, h_misplaced_tiles)\n",
        "    print(f\"\\n=========================================\")\n",
        "    print(f\"--- Misplaced Tiles Heuristic ---\")\n",
        "    print(f\"Nodes expanded: {nodes_misplaced}\")\n",
        "    print(f\"Solution path length: {len(path_misplaced) - 1} steps\")\n",
        "    display_solution_steps(path_misplaced)\n",
        "\n",
        "    # Run A* using Manhattan Distance Heuristic\n",
        "    path_manhattan, nodes_manhattan = solve_a_star(initial_state, h_manhattan_distance)\n",
        "    print(f\"\\n=========================================\")\n",
        "    print(f\"--- Manhattan Distance Heuristic ---\")\n",
        "    print(f\"Nodes expanded: {nodes_manhattan}\")\n",
        "    print(f\"Solution path length: {len(path_manhattan) - 1} steps\")\n",
        "    display_solution_steps(path_manhattan)"
      ],
